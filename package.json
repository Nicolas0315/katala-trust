{
  "name": "katala-trust",
  "version": "0.1.0",
  "private": false,
  "description": "Katala verification sidecar \u2014 lab-neutral trust, mediation, and think contract",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "katala:think": "node packages/katala/gateway/katala-think.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:katala": "tsc --noEmit -p tsconfig.katala.json",
    "verify:gateway": "vitest run packages/katala/gateway packages/katala/core/__tests__/LocalMediationManager.test.ts packages/katala/core/__tests__/AgentGatewayPolicy.test.ts",
    "verify:local": "npm test && npm run typecheck:katala && npm run verify:gateway"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "dotenv": "^17.3.1",
    "papaparse": "^5.5.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
